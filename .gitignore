# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.spec
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── MeetBot çalışma dosyaları (çalışırken oluşur) ─────────────
# Ayarlar: .env kişiseldir (şifre içerir); şablon .env.example repoda kalır
.env
.env.local
.env.*.local
!.env.example
# Botun Chrome profili (çerezler, olası Google oturumu) — ASLA paylaşmayın
chrome_profil/
# İndirilen şarkılar (her açılışta temizlenir)
downloads/
# Chrome'un sahte mikrofonu için otomatik üretilen sessiz WAV
silence.wav
*.log
examplesdonotchangeorcopy/

# ── Node.js (yalnızca Tailwind derlemesi: npm run build:css) ──
# Derlenmiş static/tailwind.css repoda tutulur; aşağıdakiler tutulmaz.
node_modules/
npm-debug.log*
.npm

# ── İşletim sistemi / editör ──────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.deb
