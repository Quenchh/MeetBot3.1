# ──────────────────────────────────────────────────────────────
#  MeetBot ayarları — bu dosyayı ".env" adıyla kopyalayıp düzenleyin.
#  Ortam değişkenleri .env dosyasındaki değerlerin önüne geçer.
# ──────────────────────────────────────────────────────────────

# ── Sunucu ────────────────────────────────────────────────────
# 0.0.0.0 → aynı ağdaki herkes panele erişebilir; sadece bu bilgisayar için 127.0.0.1
MEETBOT_HOST=0.0.0.0
# Panele IP/localhost/bilgisayar adı dışında bir alan adıyla (ör. ters vekil) erişiyorsanız o adlar; virgülle ayırın.
# "*" Host denetimini (DNS-rebinding koruması) kapatır.
# MEETBOT_TRUSTED_HOSTNAMES=meetbot.example.com
MEETBOT_PORT=8000
# DEBUG, INFO, WARNING, ERROR
MEETBOT_LOG_LEVEL=INFO

# ── Yetkilendirme ─────────────────────────────────────────────
# Yönetici şifresi. Boş bırakılırsa her açılışta rastgele bir şifre üretilir ve konsola yazılır.
MEETBOT_ADMIN_PASSWORD=
# true  → misafirler de duraklatma/geçme/sıralama/ses gibi oynatma kontrollerini kullanabilir
# false → misafirler sadece şarkı ekleyebilir ve kendi eklediklerini silebilir
MEETBOT_GUEST_CONTROLS=true
# Bot ekranı: yöneticinin panelden botun tarayıcısını görüp kullanması (ör. ekransız sunucuda Google girişi)
# local → yalnızca bu bilgisayardan / SSH tüneliyle (önerilen), on → her yerden, off → kapalı
MEETBOT_REMOTE_VIEW=local

# ── Kuyruk sınırları ──────────────────────────────────────────
MEETBOT_MAX_QUEUE=100
# Kişi başı kuyrukta bekleyebilecek en fazla şarkı (0 = sınırsız)
MEETBOT_MAX_USER_QUEUE=0
# Saniye cinsinden en uzun şarkı (0 = sınırsız, varsayılan). Örn. 1200 = 20 dakika
MEETBOT_MAX_DURATION=0
# Bir oynatma listesinden en fazla kaç şarkı eklensin
MEETBOT_PLAYLIST_LIMIT=25
# Sıradaki kaç şarkı önceden indirilsin
MEETBOT_PREFETCH=2
# "Son çalınanlar" listesinin uzunluğu
MEETBOT_HISTORY_SIZE=20

# ── Kaynaklar (yt-dlp) ────────────────────────────────────────
# İzin verilen alan adları (alt alan adları da kabul edilir)
MEETBOT_ALLOWED_HOSTS=youtube.com,youtu.be,music.youtube.com
# YouTube'un JS doğrulaması için çalışma zamanı: auto (Node.js varsa kullanılır), node, deno, bun, none
MEETBOT_YTDLP_JS_RUNTIME=auto
MEETBOT_METADATA_TIMEOUT=45
MEETBOT_DOWNLOAD_TIMEOUT=900

# ── Tarayıcı / Bot ────────────────────────────────────────────
# Google hesabı açık değilse toplantıda görünecek isim
MEETBOT_BOT_NAME=MeetBot
# Boş bırakılırsa Chrome/Edge otomatik bulunur
MEETBOT_CHROME_PATH=
MEETBOT_CDP_PORT=9222
MEETBOT_PROFILE_DIR=chrome_profil
MEETBOT_DOWNLOADS_DIR=downloads
# Toplantıya kabul edilmeyi bekleme süresi (saniye)
MEETBOT_JOIN_TIMEOUT=180
# Şarkılar arasındaki ses seviyesi farkını yumuşatan kompresör
MEETBOT_NORMALIZE=true
